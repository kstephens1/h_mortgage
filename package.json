{
  "name": "chat-hsbc-mortgage-mcp",
  "version": "0.1.0",
  "description": "A tool-only MCP server for UK repayment mortgage calculations in ChatGPT.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "chatgpt",
    "mortgage",
    "calculator"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
